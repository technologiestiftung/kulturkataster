MAP_BOUNDING_BOX=13.091992716067702,52.33488609760638,13.742786470433,52.67626223889507
MAPTILER_API_KEY=<your_api_key>

# Supabase
# https://app.supabase.com/project/_/settings/api
# CLI: $ supabase status
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-connection-string


FILE_STORAGE_BUCKET=icons

TRADUORA_API_URL=https://your-traduora-instance/api/v1
TRADUORA_CLIENT_ID=your-client-id
TRADUORA_CLIENT_SECRET=your-client-secret
TRADUORA_PROJECT_ID=your-project-id
TRADUORA_TRANSLATION_CACHE_TTL_MS=60000

SUPABASE_CATEGORY_ICONS_BUCKET=category-icons

SITE_URL=http://localhost:3000
ACCOUNT_AUTO_REFRESH_INTERVAL_MS=10000
HIDDEN_MENU_ITEMS=

# Email (frontend-managed transactional emails)
# Providers: smtp | noop
EMAIL_PROVIDER=noop
SMTP_SENDER_NAME=Kulturkataster
SMTP_SENDER_EMAIL=no-reply@example.com
SMTP_REPLY_TO=info@kulturkataster.berlin
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Port 587 + STARTTLS: keep false
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
# Recipient of institution download notifications (default: info@kulturkataster.berlin)
DOWNLOAD_NOTIFICATION_EMAIL=
# Optional for npm run email:dispatch: emails per run (default 25, max 100) and worker ID
EMAIL_OUTBOX_BATCH_SIZE=
EMAIL_OUTBOX_WORKER_ID=

# Newsletter (CleverReach)
CLEVERREACH_CLIENT_ID=your-cleverreach-client-id
CLEVERREACH_CLIENT_SECRET=your-cleverreach-client-secret
CLEVERREACH_GROUP_ID=your-cleverreach-group-id
CLEVERREACH_FORM_ID=your-cleverreach-form-id

OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint:443
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=kulturkataster-frontend

# Cap captcha for guest submissions (runtime env; captcha is off if unset)
CAP_URL=https://your-cap-instance.example
CAP_SITE_KEY=site-key-from-cap-dashboard
CAP_SECRET_KEY=sk-secret-key-from-cap-dashboard
