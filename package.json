{
	"name": "kulturkataster-frontend",
	"version": "3.1.5",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate && next build",
		"start": "next start -p 3010",
		"test:e2e": "playwright test",
		"test:e2e:fresh": "CI=true playwright test",
		"test:e2e:headed": "playwright test --headed --trace on",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:setup": "npm run build && npm run start",
		"test:unit": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:unit:watch": "vitest",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"lint": "eslint .",
		"prepare": "husky",
		"format": "prettier --check './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
		"format:fix": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
		"data:migrate": "node --import tsx ./scripts/run-data-migrations.ts",
		"data:migrate:dry-run": "node --import tsx ./scripts/run-data-migrations.ts --dry-run",
		"data:migrate:local": "dotenv -e .env.local -- node --import tsx ./scripts/run-data-migrations.ts",
		"traduora:sync": "tsx scripts/traduora-sync.ts",
		"traduora:push": "tsx scripts/traduora-sync.ts push",
		"traduora:pull": "tsx scripts/traduora-sync.ts pull && npm run format:fix",
		"i18n:audit": "tsx scripts/i18n-audit.ts",
		"email:dispatch": "tsx scripts/process-email-outbox.ts",
		"fetch-types:dev": "mkdir -p src/types && rm -rf temp-backend && git clone --depth 1 --branch dev git@github.com:technologiestiftung/kulturkataster-backend.git temp-backend && cp temp-backend/types/supabase.ts src/types/supabase.ts && rm -rf temp-backend",
		"fetch-types:prod": "mkdir -p src/types && rm -rf temp-backend && git clone --depth 1 --branch main git@github.com:technologiestiftung/kulturkataster-backend.git temp-backend && cp temp-backend/types/supabase.ts src/types/supabase.ts && rm -rf temp-backend",
		"prisma:generate": "prisma generate",
		"prisma:studio": "prisma studio",
		"prisma:migrate": "prisma migrate dev",
		"prisma:push": "prisma db push",
		"prisma:pull": "prisma db pull",
		"prisma:generate:local": "dotenv -e .env.local -- prisma generate",
		"prisma:migrate:local": "dotenv -e .env.local -- prisma migrate dev",
		"prisma:push:local": "dotenv -e .env.local -- prisma db push",
		"prisma:pull:local": "dotenv -e .env.local -- prisma db pull"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.213.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
		"@opentelemetry/resources": "^2.6.0",
		"@opentelemetry/sdk-logs": "^0.213.0",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.8.0",
		"@radix-ui/react-accordion": "^1.2.11",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-checkbox": "^1.3.2",
		"@radix-ui/react-collapsible": "^1.1.11",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@supabase/auth-helpers-nextjs": "^0.10.0",
		"@supabase/ssr": "^0.6.1",
		"@supabase/supabase-js": "^2.52.0",
		"@tanstack/match-sorter-utils": "^8.19.4",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.13.18",
		"@vercel/otel": "^2.1.0",
		"canvas-confetti": "^1.9.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"express": "^5.2.1",
		"i18next": "^25.3.2",
		"i18next-resources-to-backend": "^1.2.1",
		"idb-keyval": "^6.2.2",
		"immer": "^11.1.3",
		"lightningcss": "^1.30.1",
		"lodash": "^4.17.23",
		"lucide-react": "^0.482.0",
		"negotiator": "^1.0.0",
		"next": "^16.0.7",
		"next-i18n-router": "^5.5.3",
		"next-themes": "^0.4.6",
		"nodemailer": "^6.10.1",
		"ol": "^10.6.0",
		"ol-ext": "^4.0.33",
		"ol-mapbox-style": "^13.0.1",
		"proj4": "^2.19.7",
		"radix-ui": "^1.4.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-i18next": "^16.0.0",
		"react-markdown": "^10.1.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.0.1",
		"tailwindcss-animate": "^1.0.7",
		"xlsx-js-style": "^1.2.0",
		"zustand": "^5.0.3"
	},
	"optionalDependencies": {
		"@tailwindcss/oxide-linux-x64-gnu": "^4.1.11"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.0.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.57.0",
		"@svgr/webpack": "^8.1.0",
		"@tailwindcss/postcss": "^4.0.14",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/canvas-confetti": "^1.9.0",
		"@types/geojson": "^7946.0.16",
		"@types/lodash": "^4.17.23",
		"@types/negotiator": "^0.6.4",
		"@types/node": "^24.12.2",
		"@types/nodemailer": "^7.0.11",
		"@types/proj4": "^2.19.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.0.16",
		"dotenv": "^17.2.3",
		"eslint": "^9",
		"eslint-config-next": "16.0.2",
		"husky": "^9.1.7",
		"jsdom": "^27.4.0",
		"postcss": "^8",
		"prettier": "3.5.3",
		"prisma": "^7.8.0",
		"rehype-stringify": "^10.0.1",
		"tailwindcss": "^4.0.14",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vitest": "^4.0.16"
	}
}
