{
	"workbench.colorCustomizations": {
		"activityBar.activeBorder": "#76092d",
		"activityBar.foreground": "#e7e7e7",
		"activityBar.inactiveForeground": "#e7e7e799",
		"activityBarBadge.background": "#76092d",
		"activityBarBadge.foreground": "#e7e7e7",
		"statusBar.foreground": "#e7e7e7",
		"statusBarItem.remoteForeground": "#e7e7e7",
		"commandCenter.border": "#e7e7e799",
		"titleBar.activeForeground": "#e7e7e7",
		"titleBar.inactiveForeground": "#e7e7e799"
	},
	"peacock.color": "#0f49c3",
	"i18n-ally.localesPaths": ["src/lib/i18n/translations"],
	"cSpell.words": ["geolocate", "maplibregl"],
	"i18n-ally.keystyle": "nested",
	"i18n-ally.defaultNamespace": "common",
	"i18n-ally.namespaceSeparator": ".",
	"i18n-ally.namespaces": ["common", "content", "enumMap"],
	"i18n-ally.enabledParsers": ["json"],
	"i18n-ally.sourceLanguage": "de",
	"i18n-ally.displayLanguage": "de",
	"i18n-ally.enabledFrameworks": ["react", "i18next"],
	"i18n-ally.pathMatcher": "{locale}/{namespace}.json",
	"i18n-ally.namespace": true,
	"i18n-ally.sortKeys": true,
	"i18n-ally.keepFulfilled": true,
	"i18n-ally.indent": 2,
	"i18n-ally.usage.scanningIgnore": ["node_modules/**", "dist/**", ".next/**"],
	"i18n-ally.extract.keygenStyle": "nested",
	"i18n-ally.refactor.templates": ["{key}", "{namespace}.{key}"],
	"WillLuke.nextjs.addTypesOnSave": true,
	"WillLuke.nextjs.hasPrompted": true,
	"playwright.env": {},
	"playwright.reuseBrowser": false,
	"playwright.showTrace": false,
	"testing.openTesting": "openOnTestStart",
	"testing.automaticallyOpenTestResults": "openOnTestStart",
	"editor.formatOnSave": true,
	"editor.formatOnPaste": true
}
