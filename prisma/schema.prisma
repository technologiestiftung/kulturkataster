// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum OwnerType {
  private
  federal_property
  state_property
  state_property_silb
  state_property_soda
  state_property_other
  state_property_specialized
  state_property_fund
  district_property
  other_public_property
  municipal_housing_company
  other
}

enum RentalContractType {
  unlimited_lease
  limited_lease
  hereditary_building_right
  organization_ownership
  leasehold
}

enum FundingType {
  workspace_program
  institutional_funding
  temporary_project_funding
  no_funding
}

enum UtilizationStatus {
  in_use
  temporarily_closed
  permanently_closed
  planned_use
  unknown
  potential_space
}

enum ProtectionStatus {
  long_term_secured
  medium_term_secured
  uncertain
  acutely_threatened
  permanently_closed
  not_yet_secured
}

enum InstitutionStatus {
  public
  private
  archived
  draft
  approval_pending
  removal_pending
}

enum UserStatus {
  active
  inactive
  approval_pending
  invited
  banned
}

enum CategoryStatus {
  active
  pending
  inactive
}

enum QuestionnaireStatus {
  draft
  open
  closed
  archived
}

enum SubmissionEntityType {
  institution
  category
}

enum SubmissionStatus {
  draft
  approval_pending
  approved
  rejected
  needs_changes
}

enum ActivityStatus {
  approval_pending
  approved
  rejected
  completed
}

enum SubmissionType {
  read
  create
  claim
  update
  delete
}

enum Action {
  read
  create
  update
  delete
  download
}

enum PermissionScope {
  own
  all
}

enum EmailTemplateKind {
  auth
  custom
}

// ============================================
// CORE MODELS
// ============================================

model Address {
  id             Int      @id @default(autoincrement())
  street         String?
  street_number  String?
  address_suffix String?
  zipcode        String?
  city           String?
  district       String?
  neighbourhood  String?
  cultural_area  String?
  lat            Float?   @db.DoublePrecision
  lng            Float?   @db.DoublePrecision
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  institutions Institution[]

  @@index([lat])
  @@index([lng])
  @@index([lat, lng])
  @@index([city])
  @@index([district])
  @@index([neighbourhood])
  @@index([cultural_area])
  @@index([zipcode])
  @@map("address")
}

model ContactPerson {
  id         Int      @id @default(autoincrement())
  first_name String?
  last_name  String?
  email      String?
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  institutions_as_contact Institution[] @relation("InstitutionContact")

  @@index([email])
  @@map("contact_person")
}

model Institution {
  id                                Int                 @id @default(autoincrement())
  name                              String
  website                           String?
  phone                             String?
  email                             String?
  area                              Float?
  number_of_rooms                   Int?
  parent_organization               String?
  legal_form                        String?
  capacity                          Int?
  owner_name                        String?
  owner_type                        OwnerType?
  rental_contract_type              RentalContractType?
  rental_contract_end               DateTime?
  funding_type                      FundingType?
  utilization_status                UtilizationStatus?
  utilization_status_info           String?
  utilization_status_internal_notes String?
  protection_status                 ProtectionStatus?
  protection_status_info            String?
  shared_use_allowed                Boolean?
  protection_status_internal_notes  String?
  shared_use_info                   String?
  shared_use_equipment              String?
  shared_use_audience               String?
  shared_use_availability           String?
  shared_use_contact_person         String?
  accessibility                     String?
  cost                              String?
  established_since                 DateTime?
  established_until                 DateTime?
  closing_reason                    String?
  notes                             String?
  internal_notes                    String?
  culture_index                     Float?
  status                            InstitutionStatus   @default(public)
  import_identifier                 String?
  source                            String?
  created_by                        String?             @db.Uuid
  updated_by                        String?             @db.Uuid
  created_at                        DateTime            @default(now())
  updated_at                        DateTime            @updatedAt

  address_id        Int?
  contact_person_id Int?

  address        Address?       @relation(fields: [address_id], references: [id])
  contact_person ContactPerson? @relation("InstitutionContact", fields: [contact_person_id], references: [id])

  funding_sources FundingSource[]
  categories      Category[]
  tags            Tag[]
  groups          Group[]
  users           User[]
  creator         User?           @relation("InstitutionCreator", fields: [created_by], references: [id])
  updater         User?           @relation("InstitutionUpdater", fields: [updated_by], references: [id])
  answers         Answer[]

  @@index([status])
  @@index([address_id])
  @@index([contact_person_id])
  @@index([name])
  @@index([created_by])
  @@index([updated_by])
  @@map("institution")
}

model FundingSource {
  id             Int      @id @default(autoincrement())
  institution_id Int
  source_name    String
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  institution Institution @relation(fields: [institution_id], references: [id], onDelete: Cascade)

  @@index([institution_id])
  @@map("funding_source")
}

// ============================================
// CATEGORY & TAG SYSTEM
// ============================================

model Category {
  id                 Int            @id @default(autoincrement())
  key                String         @unique
  description        String?
  icon               String? // SVG format
  status             CategoryStatus @default(active)
  parent_category_id Int?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  parent_category  Category?     @relation("CategoryHierarchy", fields: [parent_category_id], references: [id])
  child_categories Category[]    @relation("CategoryHierarchy")
  institutions     Institution[]

  @@index([status])
  @@index([parent_category_id])
  @@map("category")
}

model Tag {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  institutions Institution[]

  @@map("tag")
}

// ============================================
// USER & PERMISSION SYSTEM
// ============================================

model User {
  id           String     @id @db.Uuid
  email        String     @unique
  first_name   String?
  last_name    String?
  phone        String?
  avatar_url   String?
  notes        String?
  account_type String?
  meta_info    Json?
  role_id      Int?
  status       UserStatus @default(approval_pending)
  compliance   Boolean    @default(false)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  role                   Role?            @relation(fields: [role_id], references: [id])
  groups                 Group[]
  institutions           Institution[]
  created_institutions   Institution[]    @relation("InstitutionCreator")
  updated_institutions   Institution[]    @relation("InstitutionUpdater")
  submissions            Submission[]     @relation("SubmissionCreator")
  reviewed_submissions   Submission[]     @relation("SubmissionReviewer")
  submission_notes       SubmissionNote[] @relation("SubmissionNoteCreator")
  entity_audits          EntityAudit[]    @relation("EntityAuditUser")
  created_questionnaires Questionnaire[]  @relation("QuestionnaireCreator")
  updated_questionnaires Questionnaire[]  @relation("QuestionnaireUpdater")
  submitted_answers      Answer[]         @relation("AnswerCreator")

  @@index([email])
  @@index([role_id])
  @@index([status])
  @@map("user")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_system   Boolean  @default(false)
  is_guest    Boolean  @default(false)

  users                    User[]
  table_permissions        RoleTablePermission[]
  field_permissions        RoleFieldPermission[]
  email_template_audiences EmailTemplateAudience[]

  @@map("role")
}

model RoleTablePermission {
  id      Int             @id @default(autoincrement())
  role_id Int
  table   String
  action  Action
  scope   PermissionScope @default(own)

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, table, action])
  @@index([role_id])
  @@index([table])
  @@map("role_table_permission")
}

model RoleFieldPermission {
  id      Int    @id @default(autoincrement())
  role_id Int
  table   String
  field   String
  action  Action

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, table, field, action])
  @@index([role_id])
  @@index([table])
  @@index([field])
  @@map("role_field_permission")
}

model PermissionFieldOrder {
  id         Int     @id @default(autoincrement())
  table      String
  field      String
  sort_order Int
  is_pinned  Boolean @default(false)

  @@unique([table, field])
  @@index([table])
  @@map("permission_field_order")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users                    User[]
  institutions             Institution[]
  email_template_audiences EmailTemplateAudience[]

  @@map("group")
}

model EmailTemplate {
  id          Int               @id @default(autoincrement())
  key         String            @unique
  path        String            @unique
  kind        EmailTemplateKind @default(custom)
  name        String?
  description String?
  subject     String?
  body        String            @db.Text
  text        String?           @db.Text
  metadata    Json?
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  audiences EmailTemplateAudience[]

  @@index([kind])
  @@index([is_active])
  @@map("email_template")
}

model EmailTemplateAudience {
  id          Int      @id @default(autoincrement())
  template_id Int
  role_id     Int?
  group_id    Int?
  metadata    Json?
  priority    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  template EmailTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  role     Role?         @relation(fields: [role_id], references: [id], onDelete: Cascade)
  group    Group?        @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([template_id, role_id, group_id])
  @@index([template_id])
  @@index([role_id])
  @@index([group_id])
  @@index([priority])
  @@map("email_template_audience")
}

model EmailOutbox {
  id                  String    @id
  to                  String
  subject             String
  template_path       String
  variables           Json?
  metadata            Json?
  status              String    @default("pending")
  attempts            Int       @default(0)
  max_attempts        Int       @default(5)
  next_attempt_at     DateTime  @default(now())
  locked_at           DateTime?
  locked_by           String?
  last_error          String?
  provider_message_id String?
  sent_at             DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([status, next_attempt_at])
  @@index([locked_at])
  @@index([created_at])
  @@map("email_outbox")
}

model Submission {
  id          Int                  @id @default(autoincrement())
  entity_type SubmissionEntityType
  entity_id   Int?
  status      SubmissionStatus     @default(draft)
  type        SubmissionType
  data        Json
  diff        Json?
  meta        Json?
  created_by  String?              @db.Uuid
  reviewed_by String?              @db.Uuid
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt
  reviewed_at DateTime?

  creator  User?            @relation("SubmissionCreator", fields: [created_by], references: [id])
  reviewer User?            @relation("SubmissionReviewer", fields: [reviewed_by], references: [id])
  notes    SubmissionNote[]
  answers  Answer[]

  @@index([entity_type])
  @@index([entity_id])
  @@index([status])
  @@index([type])
  @@index([created_by])
  @@index([reviewed_by])
  @@map("submission")
}

model SubmissionNote {
  id            Int      @id @default(autoincrement())
  submission_id Int
  note          String
  created_by    String?  @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  meta          Json?

  submission Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  creator    User?      @relation("SubmissionNoteCreator", fields: [created_by], references: [id])

  @@index([submission_id])
  @@index([created_by])
  @@index([created_at])
  @@map("submission_note")
}

// ============================================
// SURVEY / QUESTIONNAIRE SYSTEM
// ============================================

model Questionnaire {
  id             Int                 @id @default(autoincrement())
  title          String
  title_en       String?
  description    String?
  description_en String?
  status         QuestionnaireStatus @default(draft)
  meta_data      Json?
  created_by     String?             @db.Uuid
  updated_by     String?             @db.Uuid
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  questions Question[]
  answers   Answer[]
  creator   User?      @relation("QuestionnaireCreator", fields: [created_by], references: [id])
  updater   User?      @relation("QuestionnaireUpdater", fields: [updated_by], references: [id])

  @@index([status])
  @@index([created_by])
  @@index([updated_by])
  @@map("questionnaire")
}

model Question {
  id               Int      @id @default(autoincrement())
  questionnaire_id Int
  key              String
  label            String
  label_en         String?
  description      String?
  description_en   String?
  field_type       String
  required         Boolean  @default(false)
  step             Int      @default(1)
  order            Int      @default(0)
  config           Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  questionnaire Questionnaire @relation(fields: [questionnaire_id], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@unique([questionnaire_id, key])
  @@index([questionnaire_id, step, order])
  @@map("question")
}

model Answer {
  id               Int      @id @default(autoincrement())
  questionnaire_id Int
  question_id      Int
  // Exactly one of institution_id/submission_id is set (enforced by a hand-added
  // CHECK constraint in the add_answer_submission_link migration — Prisma has no
  // native @@check attribute). institution_id targets an already-approved
  // Institution; submission_id targets a still-pending Submission (e.g. someone
  // answering the questionnaire for an institution they just proposed).
  institution_id   Int?
  submission_id    Int?
  value            Json
  created_by       String?  @db.Uuid
  submitter_name   String?
  submitter_email  String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  questionnaire Questionnaire @relation(fields: [questionnaire_id], references: [id], onDelete: Cascade)
  question      Question      @relation(fields: [question_id], references: [id], onDelete: Cascade)
  institution   Institution?  @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  submission    Submission?   @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  creator       User?         @relation("AnswerCreator", fields: [created_by], references: [id])

  // "One completed questionnaire per institution/submission" is enforced in the
  // server action (answerRepo.hasAnswered), not here — deliberately no unique
  // constraint, so this stays a plain query index.
  @@index([questionnaire_id, institution_id, question_id, created_at])
  @@index([questionnaire_id, submission_id, question_id, created_at])
  @@index([question_id])
  @@index([institution_id])
  @@index([submission_id])
  @@map("answer")
}

// ============================================
// AUDIT SYSTEM
// ============================================

enum AuditAction {
  create
  update
  delete
}

enum AuditEntityType {
  institution
  address
  contact_person
  category
  tag
  funding_source
  user
  role
  group
  submission
  submission_note
  role_table_permission
  role_field_permission
}

model EntityAudit {
  id          Int             @id @default(autoincrement())
  entity_id   String
  entity_type AuditEntityType
  action      AuditAction
  old_data    Json?
  new_data    Json?
  meta_info   Json?
  status      ActivityStatus  @default(approval_pending)
  changed_by  String?         @db.Uuid
  changed_at  DateTime        @default(now())

  user User? @relation("EntityAuditUser", fields: [changed_by], references: [id])

  @@index([entity_id])
  @@index([entity_type])
  @@index([action])
  @@index([changed_by])
  @@index([changed_at])
  @@map("entity_audit")
}

model AppDataMigration {
  id    String   @id
  runAt DateTime @default(now()) @map("run_at") @db.Timestamptz(6)

  @@map("app_data_migrations")
  @@ignore
}
