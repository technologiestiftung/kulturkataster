// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum OwnerType {
  private
  federal_property
  state_property
  state_property_silb
  state_property_soda
  state_property_other
  state_property_specialized
  state_property_fund
  district_property
  other_public_property
  municipal_housing_company
  other
}

enum RentalContractType {
  unlimited_lease
  limited_lease
  hereditary_building_right
  organization_ownership
}

enum FundingType {
  workspace_program
  institutional_funding
  temporary_project_funding
  no_funding
}

enum UtilizationStatus {
  in_use
  temporarily_closed
  permanently_closed
  planned_use
  unknown
  potential_space
}

enum ProtectionStatus {
  long_term_secured
  medium_term_secured
  uncertain
  acutely_threatened
  permanently_closed
  not_yet_secured
}

enum InstitutionStatus {
  public
  private
  archived
  draft
  approval_pending
  removal_pending
}

enum UserStatus {
  active
  inactive
  approval_pending
  invited
  banned
}

enum CategoryStatus {
  active
  pending
  inactive
}

enum SubmissionEntityType {
  institution
  category
}

enum SubmissionStatus {
  draft
  approval_pending
  approved
  rejected
  needs_changes
}

enum ActivityStatus {
  approval_pending
  approved
  rejected
  completed
}

enum SubmissionType {
  read
  create
  claim
  update
  delete
}

enum Action {
  read
  create
  update
  delete
}

enum PermissionScope {
  own
  all
}


// ============================================
// CORE MODELS
// ============================================

model Address {
  id             Int      @id @default(autoincrement())
  street         String?
  street_number  String?
  address_suffix String?
  zipcode        String?
  city           String?
  district       String?
  neighbourhood  String?
  cultural_area  String?
  lat            Float?    @db.DoublePrecision
  lng            Float?    @db.DoublePrecision
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  institutions Institution[]

  @@index([lat])
  @@index([lng])
  @@index([lat, lng])
  @@index([city])
  @@index([district])
  @@index([neighbourhood])
  @@index([cultural_area])
  @@index([zipcode])
  @@map("address")
}

model ContactPerson {
  id         Int      @id @default(autoincrement())
  first_name String?
  last_name  String?
  email      String?
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  institutions_as_contact        Institution[] @relation("InstitutionContact")

  @@index([email])
  @@map("contact_person")
}

model Institution {
  id                      Int                 @id @default(autoincrement())
  name                    String
  website                 String?
  phone                   String?
  email                   String?
  area                    Float?
  number_of_rooms         Int?
  parent_organization     String?
  legal_form              String?
  capacity                Int?
  owner_name              String?
  owner_type              OwnerType?
  rental_contract_type    RentalContractType?
  rental_contract_end     DateTime?
  funding_type            FundingType?
  utilization_status      UtilizationStatus?
  utilization_status_info  String?
  protection_status       ProtectionStatus?
  protection_status_info   String?
  shared_use_allowed      Boolean             @default(false)
  shared_use_info         String?
  shared_use_equipment    String?
  shared_use_audience     String?
  shared_use_availability String?
  shared_use_contact_person String?
  accessibility           String?
  cost                    String?
  established_since       DateTime?
  established_until       DateTime?
  closing_reason          String?
  notes                   String?
  internal_notes          String?
  status                  InstitutionStatus   @default(public)
  import_identifier       String?
  source                  String?
  created_by              String?             @db.Uuid
  updated_by              String?             @db.Uuid
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  address_id                   Int?
  contact_person_id            Int?

  address                   Address?       @relation(fields: [address_id], references: [id])
  contact_person            ContactPerson? @relation("InstitutionContact", fields: [contact_person_id], references: [id])

  funding_sources FundingSource[]
  categories      Category[]
  tags            Tag[]
  groups          Group[]
  users           User[]
  creator         User?           @relation("InstitutionCreator", fields: [created_by], references: [id])
  updater         User?           @relation("InstitutionUpdater", fields: [updated_by], references: [id])

  @@index([status])
  @@index([address_id])
  @@index([contact_person_id])
  @@index([name])
  @@index([created_by])
  @@index([updated_by])
  @@map("institution")
}

model FundingSource {
  id             Int      @id @default(autoincrement())
  institution_id Int
  source_name    String
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  institution Institution @relation(fields: [institution_id], references: [id], onDelete: Cascade)

  @@index([institution_id])
  @@map("funding_source")
}

// ============================================
// CATEGORY & TAG SYSTEM
// ============================================

model Category {
  id                 Int            @id @default(autoincrement())
  key                String         @unique
  description        String?
  icon               String? // SVG format
  status             CategoryStatus @default(active)
  parent_category_id Int?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  parent_category  Category?     @relation("CategoryHierarchy", fields: [parent_category_id], references: [id])
  child_categories Category[]    @relation("CategoryHierarchy")
  institutions     Institution[]

  @@index([status])
  @@index([parent_category_id])
  @@map("category")
}

model Tag {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  institutions Institution[]

  @@map("tag")
}

// ============================================
// USER & PERMISSION SYSTEM
// ============================================

model User {
  id                 String     @id @db.Uuid
  email              String     @unique
  first_name         String?
  last_name          String?
  phone              String?
  avatar_url         String?
  notes              String?
  account_type       String?
  meta_info         Json?
  role_id            Int?
  status             UserStatus @default(approval_pending)
  compliance         Boolean    @default(false)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  role                 Role?         @relation(fields: [role_id], references: [id])
  groups               Group[]
  institutions         Institution[]
  created_institutions Institution[] @relation("InstitutionCreator")
  updated_institutions Institution[] @relation("InstitutionUpdater")
  submissions         Submission[] @relation("SubmissionCreator")
  reviewed_submissions Submission[] @relation("SubmissionReviewer")
  entity_audits        EntityAudit[] @relation("EntityAuditUser")

  @@index([email])
  @@index([role_id])
  @@index([status])
  @@map("user")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_system  Boolean  @default(false)
  is_guest  Boolean  @default(false)

  users                  User[]
  table_permissions      RoleTablePermission[]
  field_permissions      RoleFieldPermission[]

  @@map("role")
}

model RoleTablePermission {
  id      Int    @id @default(autoincrement())
  role_id Int
  table   String
  action  Action
  scope   PermissionScope @default(own)

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, table, action])
  @@index([role_id])
  @@index([table])
  @@map("role_table_permission")
}

model RoleFieldPermission {
  id      Int    @id @default(autoincrement())
  role_id Int
  table   String
  field   String
  action  Action

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, table, field, action])
  @@index([role_id])
  @@index([table])
  @@index([field])
  @@map("role_field_permission")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users        User[]
  institutions Institution[]

  @@map("group")
}

model Submission {
  id           Int                  @id @default(autoincrement())
  entity_type  SubmissionEntityType
  entity_id    Int?
  status       SubmissionStatus     @default(draft)
  type         SubmissionType
  data         Json
  diff         Json?
  meta         Json?
  review_notes String?
  created_by   String?              @db.Uuid
  reviewed_by  String?              @db.Uuid
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt
  reviewed_at  DateTime?

  creator  User? @relation("SubmissionCreator", fields: [created_by], references: [id])
  reviewer User? @relation("SubmissionReviewer", fields: [reviewed_by], references: [id])

  @@index([entity_type])
  @@index([entity_id])
  @@index([status])
  @@index([type])
  @@index([created_by])
  @@index([reviewed_by])
  @@map("submission")
}

// ============================================
// AUDIT SYSTEM
// ============================================

enum AuditAction {
  create
  update
  delete
}

enum AuditEntityType {
  institution
  address
  contact_person
  category
  tag
  funding_source
  user
  role
  group
  submission
  role_table_permission
  role_field_permission
}

model EntityAudit {
  id          Int               @id @default(autoincrement())
  entity_id   String
  entity_type AuditEntityType
  action      AuditAction
  old_data    Json?
  new_data    Json?
  meta_info   Json?
  status      ActivityStatus @default(approval_pending)
  changed_by  String?           @db.Uuid
  changed_at  DateTime          @default(now())

  user User? @relation("EntityAuditUser", fields: [changed_by], references: [id])

  @@index([entity_id])
  @@index([entity_type])
  @@index([action])
  @@index([changed_by])
  @@index([changed_at])
  @@map("entity_audit")
}
